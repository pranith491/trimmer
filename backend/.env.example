# Copy these into your hosting provider's Environment Variables panel.
# For Aiven, use the exact CA/SSL connection instructions from your Aiven console.
DB_URL=jdbc:mysql://YOUR_AIVEN_HOST:YOUR_AIVEN_PORT/defaultdb?sslMode=REQUIRED&serverTimezone=UTC
DB_USERNAME=avnadmin
DB_PASSWORD=PUT_YOUR_ROTATED_AIVEN_PASSWORD_HERE
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
JWT_EXPIRATION_MS=86400000
PORT=8080
